# AwsarSetu V1 environment template
# Copy to .env.local for local development. Never commit real secrets.

# Supabase public client configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase server-only service role key.
# Use only in protected scripts or server-only import workflows.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: enable phone OTP UI after SMS provider is configured in Supabase.
NEXT_PUBLIC_ENABLE_PHONE_OTP=false

# Optional Google OAuth is configured in Supabase Auth, not directly in this app.
# Store OAuth client secret only in Supabase provider settings.

# Resend or compatible email provider
RESEND_API_KEY=
RESEND_FROM_EMAIL=AwsarSetu Alerts <alerts@example.com>

# Browser Web Push VAPID keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerts@example.com

# Deployment
NEXT_PUBLIC_APP_URL=http://localhost:3000
